import tkinter as tk
import numpy as np
import time
import datetime
import os

# --- ADATBÁZIS FILERENDSZER ---
LOG_FILE = "Torus_Manifold_Equilibrium.csv"
if not os.path.exists(LOG_FILE):
    with open(LOG_FILE, "w", encoding="utf-8") as f:
        f.write("Timestamp,Calculated_Stride,Duration_us,Residual_Gamma,Room_Sensor_Alert\n")

# --- MESTERKÉPLET PARAMÉTEREK ---
k = 43.0
N = 1_000_000  # Nyers, könnyű tömb a stabil, hideg futáshoz
TORUS_MULTIPLIER = 5000.0  
TWO_WAY_MODE = True

# --- INTERAKTÍV SZAKASZ INTEGRÁTOR ---
# Ez határozza meg, hány fordulat alkot egy egybefüggő szakaszt. A nyilakkal állítható!
RENDER_STRIDE = 30  
current_section_samples = []

# --- TISZTA NYERS MINTAPUFFERREK ---
calibration_samples = []
local_reference_lock = 0.22  
is_calibrated = False

MAX_POINTS = 60
gamma_history = [0.0] * MAX_POINTS  

current_gamma_global = 0.0
current_stride_global = 0.0
current_duration_global = 0.0
room_status_global = "NORMAL (TER EGYENSULY)"

# --- FŐ GRAFIKAI ABLAK ---
root = tk.Tk()
root.title("43N1G1 APPLIED SPACE-TIME GEOMETRY ENGINE")
root.geometry("820x360+50+40")
root.configure(bg="black")

label_local = tk.Label(root, text="43N1G1 - LOKÁLIS 10 MÉTERES SUGÁR  [Fel/Le: Magasság | Bal/Jobb: Szakaszhossz]", fg="lime", bg="black", font=("Consolas", 10, "bold"))
label_local.pack(anchor="w", padx=20, pady=(15,0))
canvas_local = tk.Canvas(root, width=780, height=260, bg="black", highlightbackground="#111111")
canvas_local.pack(padx=20, pady=5)

def on_key_down(event):
    global TORUS_MULTIPLIER, TWO_WAY_MODE, is_calibrated, calibration_samples, RENDER_STRIDE
    if event.keysym == "Up": 
        TORUS_MULTIPLIER *= 1.2
    elif event.keysym == "Down": 
        TORUS_MULTIPLIER /= 1.2
    elif event.keysym == "Left": 
        RENDER_STRIDE += 5  # Hosszabb szakasz = Nyugodtabb, lassabb görbe
        if RENDER_STRIDE > 200: RENDER_STRIDE = 200
    elif event.keysym == "Right": 
        RENDER_STRIDE -= 5  # Röviden szakasz = Gyorsabb, nyersebb görbe
        if RENDER_STRIDE < 2: RENDER_STRIDE = 2
    elif event.keysym == "space": 
        TWO_WAY_MODE = not TWO_WAY_MODE
    elif event.keysym in ("r", "R"):
        is_calibrated = False
        calibration_samples = []

root.bind("<Key>", on_key_down)

def redraw_local_graph():
    canvas_local.delete("all")
    w, h = 780, 260
    mid_y = h / 2

    # Rács
    for x in range(50, w, 50): canvas_local.create_line(x, 0, x, h, fill="#001e00", width=1)
    if TWO_WAY_MODE: canvas_local.create_line(0, mid_y, w, mid_y, fill="#005a00", width=1)

    # Élő integrált szakaszvonal kirajzolása
    if is_calibrated and len(gamma_history) > 1:
        step_x = w / (MAX_POINTS - 1)
        flat_points = []
        for i in range(len(gamma_history)):
            x = i * step_x
            y = mid_y - (gamma_history[i] * TORUS_MULTIPLIER)
            flat_points.extend([x, y])
        canvas_local.create_line(flat_points, fill="lime", width=2)

    status_text = "SZINKRONIZÁLÁS..." if not is_calibrated else f"LOKÁLIS 10 MÉTERES SUGÁR LEZÁRVA  [Szakasz ablak: {RENDER_STRIDE} fordulat]"
    color_status = "lime" if "NORMAL" in room_status_global else "yellow"
    infostring = f"SZAKASZ ÁTLAG (Γ): {current_gamma_global:.6f} | SZORZÓ: {TORUS_MULTIPLIER:.1f} | SZILÍCIUM: {current_duration_global:.2f} us"
    canvas_local.create_text(20, 20, text=infostring, fill="lime", anchor="w", font=("Consolas", 10, "bold"))
    canvas_local.create_text(20, 220, text=f"SZOBA SENSING: {room_status_global}", fill=color_status, anchor="w", font=("Consolas", 9, "bold"))
    canvas_local.create_text(20, 240, text=status_text, fill="yellow" if not is_calibrated else "lime", anchor="w", font=("Consolas", 9, "bold"))

# --- MESTERKÉPLET ENGINE LOOP (SZAKASZ INTEGRÁLT FUTÁS) ---
base_duration_baseline = 15500.0 

def engine_tick():
    global current_stride_global, current_duration_global, current_gamma_global, room_status_global
    global is_calibrated, calibration_samples, local_reference_lock, base_duration_baseline, current_section_samples

    # 1 MILLIÓS TISZTA HARDVERMEGHAJTÁS ÉS IDŐMÉRÉS
    start_sync_ns = time.perf_counter_ns()
    i_vals = np.arange(N)
    theta = i_vals * (2 * np.pi / k)
    _ = (i_vals / k) * np.cos(theta - np.pi/2)
    end_sync_ns = time.perf_counter_ns()
    
    duration_us = (end_sync_ns - start_sync_ns) / 1000.0
    calculated_stride = (duration_us % k) / 100.0
    
    if calculated_stride > 0.43: calculated_stride = 0.43
    if calculated_stride < 0.01: calculated_stride = 0.01

    current_duration_global = duration_us
    current_stride_global = calculated_stride

    # HARDVERES MINTASZÁM-ALAPÚ ÖNKALIBRÁCIÓ
    if not is_calibrated:
        calibration_samples.append(calculated_stride)
        if len(calibration_samples) >= 500: 
            local_reference_lock = sum(calibration_samples) / len(calibration_samples)
            is_calibrated = True
            print(f"\n[NYERS MOTOR] Alapvonal rögzítve: {local_reference_lock:.4f}")
    else:
        # NYERS ADAT HOZZÁADÁSA AZ AKTUÁLIS SZAKASZHOZ
        nyers_gamma = calculated_stride - local_reference_lock
        current_section_samples.append(nyers_gamma)
        
        # HA A SZAKASZ ELÉRTE A BEÁLLÍTOTT MÉRETET, ÖSSZEGEZZÜK ÉS KIRAJZOLJUK
        if len(current_section_samples) >= RENDER_STRIDE:
            current_gamma_global = sum(current_section_samples) / len(current_section_samples)
            
            gamma_history.append(current_gamma_global)
            if len(gamma_history) > MAX_POINTS:
                gamma_history.pop(0)
                
            redraw_local_graph()
            current_section_samples.clear() # Szakasz ürítése a következő blokkhoz

    # AUTOMATA BIOLÓGIAI FIGYELŐ
    if is_calibrated:
        if base_duration_baseline == 15500.0:
            base_duration_baseline = duration_us 
        if abs(duration_us - base_duration_baseline) > 800.0:
            room_status_global = "RIASZTAS: LOKALIS MOZGÁS / BIOLÓGIAI TEVÉKENYSÉG ÉSZLELVE"
        else:
            room_status_global = "NORMAL (TER EGYENSULY)"

    # FORDULATONKÉNTI NAPLÓZÁS CSV-BE
    if is_calibrated:
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"{timestamp},{calculated_stride:.6f},{duration_us:.2f},{calculated_stride - local_reference_lock:.6f},{room_status_global}\n")

    # A tórusz saját pörgése hajtja meg az újrahívást (nincs külső órajel)
    root.after(1, engine_tick)

# --- ENGINE INDÍTÁS ---
root.after(100, engine_tick)
root.mainloop()
