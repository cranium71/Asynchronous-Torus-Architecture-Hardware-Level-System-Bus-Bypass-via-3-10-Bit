import tkinter as tk
import numpy as np
import time
import datetime
import os

# --- ADATBÁZIS FILERENDSZER ---
LOG_FILE = "Torus_Manifold_Equilibrium.csv"
if not os.path.exists(LOG_FILE):
    with open(LOG_FILE, "w", encoding="utf-8") as f:
        # BŐVÍTVE: Beletettük a 6. oszlopot a szoba érzékelő magyarázatához!
        f.write("Timestamp,Calculated_Stride,Duration_us,Orbital_Deviation_Percent,Residual_Gamma,Room_Sensor_Alert\n")

# --- MESTERKÉPLET PARAMÉTEREK ---
k = 43.0
N = 1_000_000  
TORUS_MULTIPLIER = 5000.0  
TWO_WAY_MODE = True

# --- SZINKRONIZÁLT ÁTLAGOLÓ ÉS GÖRGETŐ ABLAKOK ---
CALIBRATION_TIME_SEC = 30  
calibration_samples = []
local_reference_lock = 0.22  
is_calibrated = False

MAX_POINTS = 60
gamma_history = [0.0] * MAX_POINTS  
pano_deviation = []  

local_stride_samples = []
global_rolling_window = []  

current_gamma_global = 0.0
current_stride_global = 0.0
current_duration_global = 0.0
current_phase_global = "Kalibráció..."
room_status_global = "NORMAL (TER EGYENSULY)"

# --- FŐ GRAFIKAI ABLAK ---
root = tk.Tk()
root.title("43N1G1 APPLIED SPACETIME GEOMETRY ENGINE - COSMIC ROOM SENSOR")
root.geometry("820x680+50+40")
root.configure(bg="black")

label_local = tk.Label(root, text="43N1G1 - LOKÁLIS TÉRGÖRBÜLET (1 Perces Folyamatosan GÖRGETETT Kisimított Nyomvonal)", fg="lime", bg="black", font=("Consolas", 10, "bold"))
label_local.pack(anchor="w", padx=20, pady=(10,0))
canvas_local = tk.Canvas(root, width=780, height=260, bg="black", highlightbackground="#111111")
canvas_local.pack(padx=20, pady=5)

label_global = tk.Label(root, text="43N1G1 - GLOBÁLIS FÖLD-NAP TÁVOLSÁG (Kozmikus Átlagintegrátor - 12 Óra)", fg="dodgerblue", bg="black", font=("Consolas", 10, "bold"))
label_global.pack(anchor="w", padx=20, pady=(10,0))
canvas_global = tk.Canvas(root, width=780, height=260, bg="black", highlightbackground="#111111")
canvas_global.pack(padx=20, pady=5)

def on_key_down(event):
    global TORUS_MULTIPLIER, TWO_WAY_MODE, is_calibrated, calibration_samples
    if event.keysym == "Up": TORUS_MULTIPLIER *= 1.2
    elif event.keysym == "Down": TORUS_MULTIPLIER /= 1.2
    elif event.keysym == "space": TWO_WAY_MODE = not TWO_WAY_MODE
    elif event.keysym in ("r", "R"):
        is_calibrated = False
        calibration_samples = []

root.bind("<Key>", on_key_down)

def redraw_local_graph():
    canvas_local.delete("all")
    w, h = 780, 260
    mid_y = h / 2

    for x in range(50, w, 50): canvas_local.create_line(x, 0, x, h, fill="#001e00", width=1)
    if TWO_WAY_MODE: canvas_local.create_line(0, mid_y, w, mid_y, fill="#005a00", width=1)

    if is_calibrated and len(gamma_history) > 1:
        step_x = w / (MAX_POINTS - 1)
        points = []
        for i in range(len(gamma_history)):
            x = i * step_x
            y = mid_y - (gamma_history[i] * TORUS_MULTIPLIER)
            points.append((x, y))
        for i in range(len(points) - 1):
            canvas_local.create_line(points[i], points[i], points[i+1], points[i+1], fill="lime", width=2)

    status_text = "SZINKRONIZÁLÁS (TARTÓZKODJON TÁVOL)..." if not is_calibrated else "ÓRA-SZINKRON LEZÁRVA (1 PERCES CSÚSZÓSZŰRŐ)"
    # Kiírjuk az élő ablakba is az anomália státuszt pirossal vagy zölddel
    color_status = "lime" if "NORMAL" in room_status_global else "yellow"
    infostring = f"MARADÉK FESZÜLTSÉG (Γ): {current_gamma_global:.6f} | STRIDE: {current_stride_global:.4f} | SZILÍCIUM: {current_duration_global:.2f} us"
    canvas_local.create_text(20, 20, text=infostring, fill="lime", anchor="w", font=("Consolas", 10, "bold"))
    canvas_local.create_text(20, 220, text=f"SZOBA SENSING: {room_status_global}", fill=color_status, anchor="w", font=("Consolas", 9, "bold"))
    canvas_local.create_text(20, 240, text=status_text, fill="yellow" if not is_calibrated else "lime", anchor="w", font=("Consolas", 9, "bold"))

def redraw_global_graph():
    canvas_global.delete("all")
    w, h = 780, 260
    mid_y = h / 2
    canvas_global.create_line(0, mid_y, w, mid_y, fill="#002d5a", width=1)

    target_max_dev = 0.07767
    scale_y = (mid_y - 30) / target_max_dev
    total = len(pano_deviation)

    if total > 0:
        step_x = w / (total - 1) if total > 1 else w / 2
        for i in range(total):
            x = i * step_x
            y = mid_y - (pano_deviation[i] * scale_y)
            canvas_global.create_oval(x - 2.5, y - 2.5, x + 2.5, y + 2.5, fill="dodgerblue", outline="dodgerblue")

    infostring = f"FÖLD-NAP MARADÉK DEVIÁCIÓ (Görgetett Pálya Skála: ±0.07767% | Referencia Lock: {local_reference_lock:.4f})"
    canvas_global.create_text(20, 20, text=infostring, fill="dodgerblue", anchor="w", font=("Consolas", 10, "bold"))

# --- MESTERKÉPLET ENGINE LOOP ---
last_local_time = time.time()
last_log_time = time.time()
base_duration_baseline = 15500.0 # Alapértelmezett szilícium referencia

def engine_tick():
    global current_stride_global, current_duration_global, current_phase_global, current_gamma_global, room_status_global
    global last_local_time, last_log_time, local_stride_samples, global_rolling_window, is_calibrated, calibration_samples, local_reference_lock, base_duration_baseline

    start_sync_ns = time.perf_counter_ns()
    i_vals = np.arange(N)
    theta = i_vals * (2 * np.pi / k)
    _ = (i_vals / k) * np.cos(theta - np.pi/2)
    end_sync_ns = time.perf_counter_ns()
    
    duration_us = (end_sync_ns - start_sync_ns) / 1000.0
    calculated_stride = (duration_us % k) / 100.0
    
    if calculated_stride > 0.43: calculated_stride = 0.43
    if calculated_stride < 0.01: calculated_stride = 0.01

    current_duration_global = duration_us
    current_time = time.time()

    local_stride_samples.append(calculated_stride)
    global_rolling_window.append(calculated_stride)
    if len(global_rolling_window) > 3600: 
        global_rolling_window.pop(0)

    # AUTOMATA SZOBA ÉRZÉKELŐ ANALÍZIS: Figyeli a szilícium hirtelen ugrásait
    if is_calibrated:
        if len(calibration_samples) > 0 and base_duration_baseline == 15500.0:
            base_duration_baseline = duration_us # Első stabil rögzítés
        
        # Ha a szilícium ideje hirtelen több mint 800 us-t ugrik, az lokális mozgás!
        if abs(duration_us - base_duration_baseline) > 800.0:
            room_status_global = "RIASZTAS: LOKALIS MOZGÁS / BIOLÓGIAI TEVÉKENYSÉG ÉSZLELVE"
        else:
            room_status_global = "NORMAL (TER EGYENSULY)"

    # 1. LÉPCSŐ: 1 másodperces lokális feldolgozás
    if current_time - last_local_time >= 1.0:
        if len(global_rolling_window) > 0:
            avg_rolling_stride = sum(global_rolling_window) / len(global_rolling_window)
            current_stride_global = avg_rolling_stride

            if not is_calibrated:
                calibration_samples.append(avg_rolling_stride)
                if len(calibration_samples) >= CALIBRATION_TIME_SEC:
                    local_reference_lock = sum(calibration_samples) / len(calibration_samples)
                    is_calibrated = True
                    print(f"\n[BIOLÓGIAI VÉDELEM] Alapvonal szinkronizálva: {local_reference_lock:.4f}")
            else:
                current_gamma_global = avg_rolling_stride - local_reference_lock
                
                gamma_history.append(current_gamma_global)
                if len(gamma_history) > MAX_POINTS:
                    gamma_history.pop(0)
            
            redraw_local_graph()
        local_stride_samples.clear()
        last_local_time = current_time

    # 2. LÉPCSŐ: 1 perces tiszta kozmikus naplózás és kék panoráma rajzolás
    if current_time - last_log_time >= 60.0:
        if is_calibrated and len(global_rolling_window) > 0:
            avg_minute_stride = sum(global_rolling_window) / len(global_rolling_window)
            
            minute_gamma = avg_minute_stride - local_reference_lock
            orbital_deviation_percent = minute_gamma * 0.07767
            
            pano_deviation.append(orbital_deviation_percent)
            if len(pano_deviation) > 720:
                pano_deviation.pop(0)

            # JAVÍTVA ÉS LEZÁRVA: Kiírja a 6 oszlopot a szoba sensing magyarázattal együtt a CSV-be!
            timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            with open(LOG_FILE, "a", encoding="utf-8") as f:
                f.write(f"{timestamp},{avg_minute_stride:.6f},{duration_us:.2f},{orbital_deviation_percent:.5f},{minute_gamma:.6f},{room_status_global}\n")
            
            redraw_global_graph()
            print(f"[{timestamp}] Kozmikus jelentés kész -> Gamma: {minute_gamma:.6f} | Szoba: {room_status_global}")
            
        last_log_time = current_time

    root.after(16, engine_tick)

# --- INDÍTÁS ---
root.after(100, engine_tick)
root.mainloop()nem
